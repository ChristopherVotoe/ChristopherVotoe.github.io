{
  "name": "hand-dance-video-email",
  "main": "index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://christophervotoe.github.io"
  },
  "ratelimits": [
    { "name": "EMAIL_RATE_LIMIT", "namespace_id": "31001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RECIPIENT_RATE_LIMIT", "namespace_id": "31002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
